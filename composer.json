{
    "name": "alto/rst",
    "description": "reStructuredText document engine: parse, query, lint, build, render, translate, and safely edit RST with minimal diffs",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/altophp/rst",
    "keywords": [
        "rst",
        "restructuredtext",
        "sphinx",
        "parser",
        "linter",
        "converter"
    ],
    "support": {
        "issues": "https://github.com/altophp/rst/issues",
        "source": "https://github.com/altophp/rst"
    },
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Alto\\Rst\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alto\\Rst\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "coverage": [
            "vendor/bin/phpunit --coverage-clover=.phpunit.cache/clover.xml --coverage-text",
            "@coverage:check"
        ],
        "coverage:check": "php tests/coverage-check.php .phpunit.cache/clover.xml 97",
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "qa": [
            "@sa",
            "@cs",
            "@tests"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "tests": "vendor/bin/phpunit"
    }
}
